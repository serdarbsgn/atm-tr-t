# =====================================================================
#  atm-tr.com  (Astro statik site, Apache)
#  OTOMATİK ÜRETİLİR: src/integrations/htaccess.mjs her build'de yazar.
#  Elle değiştirmeyin; yönlendirmeler astro.config.mjs REDIRECTS'te.
#  Tüm bloklar <IfModule> içinde: ilgili modül sunucuda yoksa
#  kural sessizce atlanır, site 500 hatası vermez.
# =====================================================================

# --- Temel ayarlar ----------------------------------------------------
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .txt .xml .webmanifest

# Klasör içeriğinin listelenmesini kapat (_astro, images vb.)
# Not: Site bu satır yüzünden "500 Internal Server Error" verirse
# hosting bu ayara izin vermiyor demektir; satırı silin.
Options -Indexes

# --- Hata sayfası -----------------------------------------------------
# Olmayan adres: sitenin kendi 404 sayfası, gerçek 404 koduyla. PHP yok.
ErrorDocument 404 /404.html

# --- Yönlendirmeler ---------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Eski adresler -> yeni adresler (301) -------------------------
    # Türkçe harfler UTF-8 bayt kodu olarak yazılır (\xC5\x9F = ş,
    # \xC4\xB1 = ı ...). Astro'nun bu adresler için ürettiği sayfalar
    # 301 değil 200 + meta refresh döner (Türkçe adlı klasörleri de
    # sunucudaki zip açıcı bozuyor); gerçek 301'i bu kurallar verir.

    # /22-25-ekim-2025-sodex-fuarindaydik/
    RewriteRule ^22-25-ekim-2025-sodex-fuarindaydik/?$ https://atm-tr.com/blog/22-25-ekim-2025-sodex-fuarindaydik/ [R=301,NE,L]

    # /en/we-were-at-the-sodex-fair-on-22-25-october-2025/
    RewriteRule ^en/we-were-at-the-sodex-fair-on-22-25-october-2025/?$ https://atm-tr.com/en/blog/22-25-ekim-2025-sodex-fuarindaydik/ [R=301,NE,L]

    # /17-21-mart-2025-ish-frankfurt-fuarindaydik/
    RewriteRule ^17-21-mart-2025-ish-frankfurt-fuarindaydik/?$ https://atm-tr.com/blog/17-21-mart-2025-ish-frankfurt-fuarindaydik/ [R=301,NE,L]

    # /en/we-were-at-the-ish-frankfurt-fair-from-17-to-21-march-2025/
    RewriteRule ^en/we-were-at-the-ish-frankfurt-fair-from-17-to-21-march-2025/?$ https://atm-tr.com/en/blog/17-21-mart-2025-ish-frankfurt-fuarindaydik/ [R=301,NE,L]

    # /20-24-ocak-2024-tarihleri-arasinda-sigep-rimini-fuarina-katildik/
    RewriteRule ^20-24-ocak-2024-tarihleri-arasinda-sigep-rimini-fuarina-katildik/?$ https://atm-tr.com/blog/20-24-ocak-2024-tarihleri-arasinda-sigep-rimini-fuarina-katildik/ [R=301,NE,L]

    # /en/we-were-at-the-sigep-rimini-fair-between-january-20-24-2024/
    RewriteRule ^en/we-were-at-the-sigep-rimini-fair-between-january-20-24-2024/?$ https://atm-tr.com/en/blog/20-24-ocak-2024-tarihleri-arasinda-sigep-rimini-fuarina-katildik/ [R=301,NE,L]

