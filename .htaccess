    # /en/softwares/leafy-heat-exchanger-product-selection
    RewriteRule ^en/softwares/leafy-heat-exchanger-product-selection/?$ https://atm-tr.com/en/softwares/ [R=301,NE,L]

    # /en/softwares/low-maintenance-atm-condenser-units
    RewriteRule ^en/softwares/low-maintenance-atm-condenser-units/?$ https://atm-tr.com/en/softwares/ [R=301,NE,L]

    # /en/human-resources
    RewriteRule ^en/human-resources/?$ https://atm-tr.com/en/careers/#hr-policy [R=301,NE,L]

    # /en/human-resources/our-human-resources-policy
    RewriteRule ^en/human-resources/our-human-resources-policy/?$ https://atm-tr.com/en/careers/#hr-policy [R=301,NE,L]

    # /de/personalwesen
    RewriteRule ^de/personalwesen/?$ https://atm-tr.com/de/karriere/#personalpolitik [R=301,NE,L]

    # /de/buisvorming
    RewriteRule ^de/buisvorming/?$ https://atm-tr.com/de/rohrformung/ [R=301,NE,L]

    # /de/buisvorming/apparaat-buizen
    RewriteRule ^de/buisvorming/apparaat-buizen/?$ https://atm-tr.com/de/rohrformung/rohre-fuer-haushaltsgeraete/ [R=301,NE,L]

    # /de/buisvorming/hvac-buizen
    RewriteRule ^de/buisvorming/hvac-buizen/?$ https://atm-tr.com/de/rohrformung/rohre-fuer-klimageraete/ [R=301,NE,L]

    # http -> https
    # Cloudflare arkasında döngüye girmemesi için ziyaretçinin gerçek
    # protokolünü X-Forwarded-Proto başlığından okur.
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://atm-tr.com%{REQUEST_URI} [R=301,L]

    # www.atm-tr.com -> atm-tr.com
    RewriteCond %{HTTP_HOST} ^www\.atm-tr\.com$ [NC]
    RewriteRule ^ https://atm-tr.com%{REQUEST_URI} [R=301,L]

    # Sonunda / olmayan klasör adresi -> tek adımda https + / (Apache'nin
    # kendi yönlendirmesi Cloudflare arkasında önce http'ye gidiyor)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*[^/])$ https://atm-tr.com/$1/ [R=301,L]

    # --- 404 yedeği (normalde KAPALI) ---------------------------------
    # Normalde yukarıdaki ErrorDocument yeterli (gerçek 404 kodu). Hosting
    # onu ezerse (canlıda olmayan bir adreste hosting'in kendi sayfası
    # çıkarsa) bir sonraki satırın başındaki # işaretini kaldırın: olmayan
    # adresler 404 sayfasına içeriden aktarılır. Durum kodu o zaman 200
    # olur; 404 sayfaları noindex taşıdığı için Google onları dizine almaz.
    # (Kalıcı yapmak için: astro.config.mjs'te htaccess({ fallback404: true }).)
    # RewriteRule ^ - [E=FALLBACK404:1]

    RewriteCond %{ENV:FALLBACK404} =1
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d [OR]
    RewriteCond %{REQUEST_FILENAME}/index.html !-f
    RewriteRule ^ - [E=NOTFOUND:1]

    RewriteCond %{ENV:NOTFOUND} =1
    RewriteRule ^ /404.html [L]

    # index.html'i olmayan klasörler (_astro/, images/ ...): çıplak
    # "403 Forbidden" yerine 404 (yukarıdaki ErrorDocument sayfası)
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html !-f
    RewriteRule ^ - [R=404,L]
</IfModule>

# --- MIME türleri -----------------------------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json  .webmanifest
    AddType font/woff2                 .woff2
    AddType image/webp                 .webp
    AddType image/svg+xml              .svg
    AddType video/mp4                  .mp4
    AddType text/plain                 .txt
</IfModule>

# --- Sıkıştırma -------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/xml application/json
    AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

# --- Tarayıcı önbelleği -----------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 week"

    # HTML ve site haritaları: her zaman güncel sürüm kontrol edilsin
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType application/xml           "access plus 0 seconds"
    ExpiresByType text/xml                  "access plus 0 seconds"
    ExpiresByType text/plain                "access plus 1 hour"
    ExpiresByType application/manifest+json "access plus 1 week"

    # JS/CSS sadece _astro/ içinde ve dosya adları hash'li -> uzun süre
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType text/css                  "access plus 1 year"

    # Görsel, video, font
    ExpiresByType image/webp                "access plus 1 month"
    ExpiresByType image/jpeg                "access plus 1 month"
    ExpiresByType image/png                 "access plus 1 month"
    ExpiresByType image/svg+xml             "access plus 1 month"
    ExpiresByType image/x-icon              "access plus 1 month"
    ExpiresByType image/vnd.microsoft.icon  "access plus 1 month"
    ExpiresByType video/mp4                 "access plus 1 month"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# --- Güvenlik başlıkları ----------------------------------------------
<IfModule mod_headers.c>
    # deploy/nginx-security-headers.conf ile aynı başlıklar.
    Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; require-trusted-types-for 'script'"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # HSTS 1. aşama (5 dk). HTTPS bir hafta sorunsuz çalışınca 31536000 yapın.
    Header always set Strict-Transport-Security "max-age=300"
    Header unset X-Powered-By
</IfModule>
