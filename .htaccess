    RewriteRule ^yazilimlar/yaprakli-esanjor-urun-secim-programi/?$ https://atm-tr.com/yazilimlar/ [R=301,NE,L]

    # /yazilimlar/dusuk-bakimli-atm-kondanser-secimi
    RewriteRule ^yazilimlar/dusuk-bakimli-atm-kondanser-secimi/?$ https://atm-tr.com/yazilimlar/ [R=301,NE,L]

    # /en/softwares/cold-room-calculation
