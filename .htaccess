    RewriteRule ^wp-content/uploads/2024/10/ATM-COILS-TUBE-TECHNOLOGIES-2024\.pdf/?$ https://atm-tr.com/urunler/katalog.pdf [R=301,NE,L]

    # /en/low-maintenance-atm-condenser-units
    RewriteRule ^en/low-maintenance-atm-condenser-units/?$ https://atm-tr.com/en/wire-on-tube-condensers/low-maintenance-atm-condensers-patented/ [R=301,NE,L]

    # /de/wartungsarme-atm-kondensatoreinheiten
    RewriteRule ^de/wartungsarme-atm-kondensatoreinheiten/?$ https://atm-tr.com/de/drahtrohrverfluessiger/wartungsarme-atm-verfluessiger/ [R=301,NE,L]

    # /yazilimlar/soguk-oda-hesaplama-programi
    RewriteRule ^yazilimlar/soguk-oda-hesaplama-programi/?$ https://atm-tr.com/yazilimlar/ [R=301,NE,L]

